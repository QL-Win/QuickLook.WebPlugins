{
  "name": "excalidraw",
  "version": "1.0.0",
  "description": "Browser-based Excalidraw viewer — renders .excalidraw files directly in the browser without Node.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:singlefiles": "node ./scripts/make-singlefiles.js",
    "build:all": "npm run build && npm run build:singlefiles",
    "preview": "vite preview"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.17.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

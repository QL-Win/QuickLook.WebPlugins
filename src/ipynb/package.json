{
  "name": "ipynb",
  "version": "1.0.0",
  "description": "Browser-based Jupyter Notebook viewer — renders .ipynb files directly in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:singlefiles": "node ./scripts/make-singlefiles.js",
    "build:all": "npm run build && npm run build:singlefiles",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "marked": "^15.0.12",
    "marked-katex-extension": "^5.1.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

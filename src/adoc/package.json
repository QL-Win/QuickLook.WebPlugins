{
  "name": "adoc",
  "version": "1.0.0",
  "description": "Browser-based AsciiDoc viewer — renders .adoc files directly in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:singlefiles": "node ./scripts/make-singlefiles.js",
    "build:all": "npm run build && npm run build:singlefiles",
    "preview": "vite preview"
  },
  "dependencies": {
    "@asciidoctor/core": "^4.0.2",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
